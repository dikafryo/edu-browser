{
  "manifest_version": 3,
  "name": "교직원 업무도우미",
  "version": "26.1028.10",
  "description": "교직원 업무 보조: 업무포털에서 나이스·K-에듀파인 열기, 결재·공람 점검, 나이스 복무·출장 입력, 공문헬퍼 연결",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "교직원 업무도우미 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}

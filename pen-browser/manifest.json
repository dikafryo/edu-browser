{
  "manifest_version": 3,
  "name": "PEN 브라우저 (업무 도우미)",
  "version": "26.1027.2",
  "description": "업무 사이트 바로가기, K-에듀파인 결재·공람 점검, 나이스 복무·출장 입력, 공문작성 도우미와 짝으로 쓰는 확장 프로그램",
  "key": "",
  "permissions": ["sidePanel", "storage", "tabs", "tabGroups", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "PEN 브라우저 열기" }
}
